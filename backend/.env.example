NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/magaf_internal
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5174
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
UPLOAD_MAX_FILE_SIZE_MB=25
INITIAL_ADMIN_PASSWORD=1234567890
INITIAL_FOUNDERS=[{"name":"Founder One","email":"founder1@example.com"},{"name":"Founder Two","email":"founder2@example.com"}]
